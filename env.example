# Copy this file to .env and fill it in. Never commit .env itself.

# --- AI provider --------------------------------------------------------------
# An OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Leave blank to use the built-in default model.
# A ":free" model shares a pool with everyone else and gets rate-limited; either
# attach your own provider key to OpenRouter (BYOK) or name a paid model here.
OPENROUTER_MODEL=

# --- Sending ------------------------------------------------------------------
# true  = replies fully covered by business_rules.txt are sent automatically
# false = every reply waits for a human in the review app
AUTO_SEND_ENABLED=false

# How sure the AI must be before it may send on its own, 0 to 1.
AUTO_SEND_CONFIDENCE=0.90

# true = replies you approve are delivered during the normal rota
# false = they wait for: draft_reply.py --deliver-approved
APPROVED_DELIVERY_ENABLED=false

# --- Review app ---------------------------------------------------------------
# Where the app runs. Keep it on 127.0.0.1 unless you have deliberately decided
# to expose it.
REVIEW_SERVICE_URL=http://127.0.0.1:8770

# A long random string. The same value must be set on every machine that talks
# to the app, and it is also the token in the app's URL.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(24))"
REVIEW_SERVICE_SECRET=

# Optional. An approval not delivered within this many hours goes back to the
# queue instead of being sent late.
APPROVAL_EXPIRY_HOURS=6

# Optional. A delivery that never reports back is flagged after this long.
SENDING_TIMEOUT_MINUTES=20

# --- Single-phone commands ----------------------------------------------------
# Which phone a hand-run command drives. The rota sets this itself, so it only
# matters for commands you type, such as --deliver-approved.
DEVICE_SERIAL=
